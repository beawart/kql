AddonAzureBackupJobs
| where TimeGenerated between (ago(30d) .. now())
| where JobStatus == "Completed"
| where JobOperation == "Backup"
| where BackupManagementType == "IaaSVM" 
| summarize Backups=count() by BackupItemUniqueId
| project VMs = split(BackupItemUniqueId, ";")[-1], Backups, Percentage = round(Backups * 100.0 / 30, 3)